<configuration>
    <settings>
        <!-- Auto-map snake_case DB columns to camelCase Java fields -->
        <setting name="mapUnderscoreToCamelCase" value="true"/>
        <!-- Use SLF4J for MyBatis SQL logging (controlled by logging.level in application.yml) -->
        <setting name="logImpl" value="SLF4J"/>
        <!-- Default timeout (seconds) for all statement executions -->
        <setting name="defaultStatementTimeout" value="30"/>
        <!-- Use NULL jdbcType when parameter value is null (avoids MySQL driver ambiguity) -->
        <setting name="jdbcTypeForNull" value="NULL"/>
        <!-- Enable MyBatis cache -->
        <setting name="cacheEnabled" value="true"/>
    </settings>
</configuration>